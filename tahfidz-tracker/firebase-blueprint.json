{
  "entities": {
    "Santri": {
      "title": "Santri",
      "description": "Profil santri beserta statistik dan seluruh riwayat setoran hafalan",
      "type": "object",
      "properties": {
        "nama": { "type": "string", "maxLength": 100 },
        "nis": { "type": "string", "maxLength": 50 },
        "gender": { "type": "string", "enum": ["santriwan", "santriwati"] },
        "kelasId": { "type": "string", "maxLength": 64 },
        "kelasNama": { "type": "string", "maxLength": 100 },
        "kelompokId": { "type": "string", "maxLength": 64 },
        "kelompokNama": { "type": "string", "maxLength": 100 },
        "targetJuz": { "type": "number" },
        "totalJuzMemorized": { "type": "number" },
        "kehadiranPersen": { "type": "number" },
        "weeklyGrowthJuz": { "type": "number" },
        "orangTuaNama": { "type": "string", "maxLength": 100 },
        "orangTuaPhone": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nama", "gender", "kelasId", "kelasNama", "kelompokId", "kelompokNama"]
    },
    "HafalanEntry": {
      "title": "HafalanEntry",
      "description": "Catatan setoran hafalan baru, muroja'ah, atau perbaikan santri",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 64 },
        "studentName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["baru", "muroja", "perbaikan"] },
        "category": { "type": "string", "enum": ["juz", "surah", "ayat"] },
        "juz": { "type": "number" },
        "surahNumber": { "type": "number" },
        "surahName": { "type": "string", "maxLength": 100 },
        "ayatMulai": { "type": "number" },
        "ayatSelesai": { "type": "number" },
        "kualitas": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "catatan": { "type": "string", "maxLength": 500 },
        "tanggal": { "type": "string", "maxLength": 20 },
        "ustadzName": { "type": "string", "maxLength": 100 }
      },
      "required": ["studentId", "studentName", "type", "juz", "surahName", "kualitas", "tanggal"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Riwayat absensi kehadiran sesi tahfidz santri",
      "type": "object",
      "properties": {
        "tanggal": { "type": "string", "maxLength": 20 },
        "sessionKey": { "type": "string", "maxLength": 50 },
        "sessionName": { "type": "string", "maxLength": 100 },
        "studentId": { "type": "string", "maxLength": 64 },
        "studentName": { "type": "string", "maxLength": 100 },
        "kelompokId": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["hadir_tepat", "hadir_terlambat", "tidak_hadir"] },
        "keterangan": { "type": "string", "maxLength": 300 },
        "catatanPerilaku": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["tanggal", "sessionKey", "studentId", "studentName", "status", "timestamp"]
    },
    "TasmiRecord": {
      "title": "TasmiRecord",
      "description": "Ujian tasmi sekali duduk santri",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 64 },
        "studentName": { "type": "string", "maxLength": 100 },
        "kelompokNama": { "type": "string", "maxLength": 100 },
        "gender": { "type": "string", "enum": ["santriwan", "santriwati"] },
        "targetJuzText": { "type": "string", "maxLength": 100 },
        "tanggal": { "type": "string", "maxLength": 20 },
        "waktu": { "type": "string", "maxLength": 20 },
        "penguji": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["belum", "terjadwal", "selesai"] },
        "nilai": { "type": "string", "maxLength": 10 },
        "catatan": { "type": "string", "maxLength": 500 }
      },
      "required": ["studentId", "studentName", "targetJuzText", "penguji", "status"]
    },
    "Kelas": {
      "title": "Kelas",
      "description": "Data master kelas santri",
      "type": "object",
      "properties": {
        "nama": { "type": "string", "maxLength": 100 },
        "tingkat": { "type": "string", "maxLength": 100 },
        "waliKelas": { "type": "string", "maxLength": 100 }
      },
      "required": ["nama", "tingkat"]
    },
    "Kelompok": {
      "title": "Kelompok",
      "description": "Data master kelompok halaqah tahfidz",
      "type": "object",
      "properties": {
        "nama": { "type": "string", "maxLength": 100 },
        "pengajar": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 }
      },
      "required": ["nama", "pengajar"]
    },
    "SesiTahfidz": {
      "title": "SesiTahfidz",
      "description": "Sesi waktu halaqah tahfidz harian",
      "type": "object",
      "properties": {
        "key": { "type": "string", "maxLength": 50 },
        "nama": { "type": "string", "maxLength": 100 },
        "jamMulai": { "type": "string", "maxLength": 20 },
        "jamSelesai": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["Aktif", "Nonaktif"] }
      },
      "required": ["key", "nama", "jamMulai", "jamSelesai", "status"]
    },
    "TargetHafalan": {
      "title": "TargetHafalan",
      "description": "Master target capaian juz santri",
      "type": "object",
      "properties": {
        "nama": { "type": "string", "maxLength": 100 },
        "jumlahJuz": { "type": "number" }
      },
      "required": ["nama", "jumlahJuz"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Akun login guru, admin, atau wali santri",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "password": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "guru", "coordinator", "parent"] },
        "studentId": { "type": "string", "maxLength": 64 },
        "studentName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "email", "role"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Pengaturan identitas lembaga dan konfigurasi global sistem tahfidz",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string", "maxLength": 200 },
        "schoolLeader": { "type": "string", "maxLength": 200 },
        "academicYear": { "type": "string", "maxLength": 100 },
        "minTasmiGrade": { "type": "string", "maxLength": 10 },
        "targetWeeklySetoran": { "type": "number" },
        "helpdeskWhatsapp": { "type": "string", "maxLength": 50 },
        "maintenanceMode": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["schoolName"]
    },
    "DeletedUser": {
      "title": "DeletedUser",
      "description": "Daftar akun pengguna yang telah dihapus dan dicabut hak aksesnya oleh Super Admin",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "username": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 200 },
        "deletedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "deletedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Koleksi akun pengguna guru, admin, dan wali santri"
    },
    "/deleted_users/{deletedId}": {
      "schema": "DeletedUser",
      "description": "Koleksi akun yang telah dihapus oleh Super Admin"
    },
    "/system_settings/{settingId}": {
      "schema": "SystemSettings",
      "description": "Pengaturan identitas lembaga yang tersinkron ke seluruh akun"
    },
    "/santri/{santriId}": {
      "schema": "Santri",
      "description": "Koleksi data master santri beserta riwayat hafalannya"
    },
    "/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Koleksi riwayat absensi halaqah harian"
    },
    "/tasmi/{tasmiId}": {
      "schema": "TasmiRecord",
      "description": "Koleksi pendaftaran dan hasil ujian tasmi"
    },
    "/classes/{classId}": {
      "schema": "Kelas",
      "description": "Koleksi master kelas"
    },
    "/groups/{groupId}": {
      "schema": "Kelompok",
      "description": "Koleksi master kelompok/halaqah"
    },
    "/sessions/{sessionId}": {
      "schema": "SesiTahfidz",
      "description": "Koleksi master sesi tahfidz"
    },
    "/targets/{targetId}": {
      "schema": "TargetHafalan",
      "description": "Koleksi target hafalan"
    }
  }
}
